<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="syy.portPilotage.mapper.PlanPilotBoatAssignmentsMapper">

    <resultMap id="BaseResultMap" type="syy.portPilotage.entity.PlanPilotBoatAssignments">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="planId" column="plan_id" jdbcType="BIGINT"/>
            <result property="pilotBoatId" column="pilot_boat_id" jdbcType="BIGINT"/>
            <result property="purpose" column="purpose" jdbcType="VARCHAR"/>
            <result property="estimatedStartTime" column="estimated_start_time" jdbcType="TIMESTAMP"/>
            <result property="estimatedEndTime" column="estimated_end_time" jdbcType="TIMESTAMP"/>
            <result property="actualStartTime" column="actual_start_time" jdbcType="TIMESTAMP"/>
            <result property="actualEndTime" column="actual_end_time" jdbcType="TIMESTAMP"/>
            <result property="status" column="status" jdbcType="OTHER"/>
            <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
            <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,plan_id,pilot_boat_id,purpose,estimated_start_time,estimated_end_time,
        actual_start_time,actual_end_time,status,created_at,updated_at
    </sql>
    <insert id="insertBatch">
        insert into plan_pilot_boat_assignments (plan_id, pilot_boat_id, purpose, estimated_start_time, estimated_end_time,
        actual_start_time, actual_end_time, status, created_at, updated_at)
        values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.planId}, #{item.pilotBoatId}, #{item.purpose}, #{item.estimatedStartTime}, #{item.estimatedEndTime},)
        </foreach>
    </insert>
    <!-- 更新分配状态 -->
    <update id="updateAssignmentStatus">
        UPDATE plan_pilot_boat_assignments
        SET status = #{status},
            updated_at = NOW()
        WHERE plan_id = #{planId}
          AND pilot_boat_id = #{pilotBoatId}
    </update>

    <!-- 更新实际时间 -->
    <update id="updateActualTimes">
        UPDATE plan_pilot_boat_assignments
        SET actual_start_time = #{actualStartTime},
            actual_end_time = #{actualEndTime},
            updated_at = NOW()
        WHERE plan_id = #{planId}
          AND pilot_boat_id = #{pilotBoatId}
    </update>
</mapper>
